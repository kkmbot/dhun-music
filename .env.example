# Copy to .env (local dev) or set as secrets/variables on your server host.
# Never commit real values.

# Telegram bot token from @BotFather
BOT_TOKEN=123456789:replace-with-your-bot-token

# Bot username without @ (used for the t.me/<bot>?start=... connect link)
BOT_USERNAME=your_bot_username

# Your own Telegram numeric user id (only this id can use /admin, /stats, /users, /broadcast)
ADMIN_ID=123456789

# Private group/channel id where the bot stores each song once (bot must be admin there), e.g. -1001234567890
STORAGE_CHAT_ID=-1001234567890

# Random string (letters/numbers, 20-256 chars). Same value goes in setWebhook's secret_token.
WEBHOOK_SECRET=replace-with-a-long-random-string

# Public https address where this server runs, with trailing slash
PUBLIC_URL=https://your-app.example.workers.dev/

# Optional: Telegram channel/group id for new-user logs (bot must be admin and allowed to post), e.g. -1001234567890
# Leave empty to turn logging off.
LOG_CHANNEL_ID=

# Optional: Telegram handle (without @) shown as support contact in bot messages
SUPPORT_TG=Memer_guru
