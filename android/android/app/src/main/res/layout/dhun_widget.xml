<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dhun_widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/dw_art"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="@string/dhun_widget_open"
            android:scaleType="centerCrop"
            android:src="@drawable/dhun_widget_art_placeholder" />

        <LinearLayout
            android:id="@+id/dw_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dw_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/dhun_widget_empty_title"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dw_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/dhun_widget_empty_sub"
                android:textColor="#FF9A9AA2"
                android:textSize="13sp" />
        </LinearLayout>


        <ImageButton
            android:id="@+id/dw_prev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/dhun_widget_btn_bg"
            android:contentDescription="@string/dhun_widget_prev"
            android:scaleType="center"
            android:src="@drawable/dhun_widget_ic_prev" />

        <ImageButton
            android:id="@+id/dw_toggle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/dhun_widget_play_bg"
            android:contentDescription="@string/dhun_widget_toggle"
            android:scaleType="center"
            android:src="@drawable/dhun_widget_ic_play" />

        <ImageButton
            android:id="@+id/dw_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/dhun_widget_btn_bg"
            android:contentDescription="@string/dhun_widget_next"
            android:scaleType="center"
            android:src="@drawable/dhun_widget_ic_next" />

</LinearLayout>
